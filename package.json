{
  "name": "n8n-nodes-langdock",
  "version": "0.1.1",
  "description": "n8n community node to call the Langdock API: send messages to Langdock Agents, run OpenAI-compatible chat completions across providers, and create text embeddings.",
  "keywords": [
    "n8n-community-node-package",
    "langdock",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Deichblick/Langdock-N8N-Node",
  "author": {
    "name": "Deichblick GmbH"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Deichblick/Langdock-N8N-Node.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LangdockApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Langdock/Langdock.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jsonc-eslint-parser": "^3.3.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  }
}
